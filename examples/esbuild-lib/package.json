{
  "name": "react-scope-style-esbuild-lib-example",
  "private": true,
  "version": "0.0.0",
  "description": "esbuild lib-mode (no-bundle) example — shared app sources",
  "sideEffects": true,
  "scripts": {
    "build": "react-scope-style build --config lib-scope.config.cjs",
    "build:defaults": "react-scope-style build --root ../shared --src ./src --out ./dist"
  },
  "dependencies": {
    "babel-preset-react-scope-style": "file:../..",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "esbuild": "^0.25.0",
    "sass": "^1.81.0"
  }
}
