{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "★ Attach postcss-nesting (推荐)",
      "port": 9229,
      "address": "127.0.0.1",
      "restart": false,
      "preLaunchTask": "debug: wait on port 9229 (postcss-nesting)",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "★ Attach Current Test File (推荐)",
      "port": 9229,
      "address": "127.0.0.1",
      "restart": false,
      "preLaunchTask": "debug: wait on port 9229 (current test file)",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach 9229 (手动：终端已运行 inspect-brk)",
      "port": 9229,
      "address": "127.0.0.1",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch debug-test (inspect-brk)",
      "runtimeExecutable": "D:\\ESoft\\nodejs\\node.exe",
      "runtimeArgs": ["--inspect-brk=9229"],
      "program": "${workspaceFolder}/scripts/debug-test.js",
      "args": ["${workspaceFolder}/test/postcss-nesting.test.js"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "",
        "VSCODE_INSPECTOR_OPTIONS": ""
      },
      "console": "integratedTerminal",
      "stopOnEntry": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "test (all, no debug)",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "D:\\ESoft\\nodejs\\node.exe",
      "program": "${workspaceFolder}/scripts/run-tests.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
